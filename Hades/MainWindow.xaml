<Window x:Class="Hades.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Hades.Views"
        xmlns:viewModels="clr-namespace:Hades.ViewModels"
        Title="Hades Randomizer "
        Height="420"
        Width="800"
        ResizeMode="CanMinimize"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>

        <!-- ViewModel -> View -->
        <DataTemplate DataType="{x:Type viewModels:ShowdownOfTheErdtree3ViewModel}">
            <views:ShowdownOfTheErdtree3View />
        </DataTemplate>
        
        <!-- ViewModel -> View -->
        <DataTemplate DataType="{x:Type viewModels:TwoWorldsCollideViewModel}">
            <views:TwoWorldsCollideView />
        </DataTemplate>

        <!-- ViewModel -> View -->
        <DataTemplate DataType="{x:Type viewModels:LandLockedViewModel}">
            <views:LandLockedView />
        </DataTemplate>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0"
                    ItemsSource="{Binding AvailableFormats}"
                    SelectedItem="{Binding SelectedFormat}">
        
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding ViewModel.Title}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
        
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding ViewModel}" />
                </DataTemplate>
            </TabControl.ContentTemplate>
        
        </TabControl>

        <Button Grid.Row="1"
                Content="About"
                Width="60"
                Height="30"
                Padding="4"
                HorizontalAlignment="Right"
                Margin="0,8,16,16"
                Click="AboutButton_Click" />

    </Grid>

</Window>
